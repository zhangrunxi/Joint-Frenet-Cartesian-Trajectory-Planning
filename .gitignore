.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.DS_Store

# acados / generated solver artifacts
vendor/acados/lib/
vendor/acados/c_generated_code/
**/build/
**/ocp.json
*.dylib
*.so

# archived results are large; the summary tables and figures are kept
results/**/*.json
!results/**/summary.json
!results/**/summary.csv
!results/**/provenance.json
!results/**/protocol.json
!results/**/cases.json
!results/**/*.png

# The archived benchmark runs are exceptions: their per-method statistics are
# the evidence the reviewer response quotes, and the archive was reduced to
# those statistics precisely so that they can be checked. The trajectory
# fields were dropped by scripts/archive_benchmark_statistics.py.
!results/archived/random_benchmark/**/*.json
!results/archived/random_benchmark_overtake/**/*.json
!results/archived/random_benchmark_pre_correction/**/*.json
!results/archived/random_benchmark_overtake_pre_correction/**/*.json
!results/archived/contour_accuracy/**/*.json
!results/archived/random_benchmark_ablation/**/*.json
!results/archived/random_benchmark_nine_state_serial/**/*.json

# copyrighted papers are not redistributed
sources/*.pdf
